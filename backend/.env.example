# UFC MarX Risk Engine — Backend Environment (TEMPLATE)
# =====================================================
# DUPLICATE this file to `.env` then fill secrets.
# NEVER commit `.env` to git (backend/.gitignore already blocks it).

# ——— Supabase (Tier 1: cards + bets persistence) ———
# Get these from https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=https://jlizbewyzydsaqdyopnq.supabase.co
SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE
SUPABASE_JWT_SECRET=PASTE_JWT_SECRET_HERE

# ---- Odds Feed Provider (Tier 2: live UFC lines) ----
# Provider: https://odds-api.io/ v3 (DIFFERENT from the-odds-api.com / theoddsapi.com — user confirmed this is correct one)
# Free tier: 100 requests/hr · 500/day
#   Sign up / get key: https://odds-api.io/#pricing
# Paid: higher req/hr cap + DraftKings/FanDuel/Bet365/1xbet/Stake + 265 books via tier upgrade
#
# ODDS_API_PROVIDER=STUB_DEMO           # demo stub fixture only (UFC 312: Adesanya 2.1 / DuPlessis 1.79)
ODDS_API_PROVIDER=odds-api.io
ODDS_API_KEY=

# ---- Optional: override free-tier 2-bookmaker limit on odds-api.io ----
# Free tier allows 2 books only. Defaults: ["1xbet", "Stake"].
# If odds-api errors: "Access denied. You're allowed max 2 bookmakers. Allowed: X, Y"
# → paste exactly those 2 books here:
# ODDS_API_BOOKMAKERS=1xbet,Stake

# ——— CORS Origins (WS-F tightening) ———
# Dev only: keep "*" for easy localhost debugging.
# Production: list EXACT origins only, comma separated.
#   Example (Vercel frontend + custom domain + local QA):
#     CORS_ORIGINS=https://ufc-marx.vercel.app,https://ufcmarx.com,http://localhost:8080,http://localhost:8787
CORS_ORIGINS=*,http://localhost:8080,http://localhost:8081,http://localhost:8787

# ——— Port (single-box deploy) ———
# PORT=8787
